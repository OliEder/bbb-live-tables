<?xml version="1.0"?>
<ruleset name="BBB Live Tables">
	<description>WordPress Coding Standards für das BBB Live Tables Plugin.</description>

	<file>.</file>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/blocks/*/editor.asset.php</exclude-pattern>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bbb-live-tables"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bbb"/>
				<element value="BBB"/>
				<element value="bbb_tables"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.0"/>
</ruleset>
